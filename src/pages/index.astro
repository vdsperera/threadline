---
import config from '../../config.json';
import manifest from '../../cases/manifest.json';
const allFiles = import.meta.glob('../../cases/*.json', { eager: true });
const allCases = manifest.map(id => allFiles[`../../cases/${id}.json`]);
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Threadline — Interactive Case Timelines</title>
<meta name="description" content="A growing library of interactive case timelines — each one traces how a real investigation actually unfolded, evidence by evidence.">
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href={`${import.meta.env.BASE_URL}style.css`}>
</head>
<body>

<div class="topbar">
  <a href={import.meta.env.BASE_URL} class="brand" style="text-decoration:none;"><span>Threadline</span><span class="count">{allCases.length} case{allCases.length !== 1 ? 's' : ''}</span></a>
</div>

<div id="view-index">
  <div class="index-hero">
    <h1>Threadline</h1>
    <p>A growing library of interactive case timelines — each one traces how a real investigation actually unfolded, evidence by evidence. Open a case to filter its timeline by category or by person.</p>
  </div>
  <div class="case-grid">
    {allCases.map(c => {
      const usedCats = [...new Set(c.events.map(e => e.cat))];
      return (
        <a href={`${import.meta.env.BASE_URL}${c.id}`} class="case-card" style="text-decoration:none; color:inherit; text-align:left; display:block;">
          <div class="case-tab mono">
            <span>{c.location}</span>
            <span>{c.years}</span>
          </div>
          <h3 style="margin: 8px 0; font-size: 20px;">{c.title}</h3>
          <p style="margin: 0 0 12px 0; font-size: 15px;">{c.cardBlurb || c.dek}</p>
          <div class="case-footer">
            {c.statusBadge ? (
              <span class="status-badge" style={`color: ${c.statusBadge.color}`}>{c.statusBadge.label}</span>
            ) : <span></span>}
            <div class="cat-dots">
              {usedCats.map(k => (
                <span style={`background: ${config.cats[k].color}`}></span>
              ))}
            </div>
          </div>
        </a>
      )
    })}
  </div>
</div>

</body>
</html>
